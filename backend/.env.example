PORT=5000

# OpenWeatherMap API key - https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Auth0 tenant domain, e.g. dev-xxxxxxxx.us.auth0.com (no https://, no trailing slash)
AUTH0_DOMAIN=

# Must match the API Identifier configured in the Auth0 dashboard
# and VITE_AUTH0_AUDIENCE in the frontend .env
AUTH0_AUDIENCE=https://weather-analytics-api