# Auth0 SPA application settings (Application type: Single Page Application)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id

# Must match AUTH0_AUDIENCE in the backend .env and the API Identifier in Auth0
VITE_AUTH0_AUDIENCE=https://weather-analytics-api

# Backend base URL (optional - defaults to http://localhost:5000)
VITE_API_BASE_URL=http://localhost:5000
